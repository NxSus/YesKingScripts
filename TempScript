local function ComputeChecksum(value)
    local checksum = 0
    for i = 1, #value do
        checksum = (checksum + value:byte(i)) % 256
    end
    return checksum
end

local BaseMultiplier = 1.2358
local InitializationVector = {74, 23, 58, 99, 120}

function SecureTransmission()
    local HashKey = ComputeChecksum("NumValue")
    while _G.TempValue == true do 
        local dataPacket = {
            [1] = _G.NumTempValue,
            [2] = BaseMultiplier * math.random(),
            [3] = HashKey + InitializationVector[math.random(1, #InitializationVector)] 
        }
        
        game:GetService("ReplicatedStorage").Remotes.Drop:FireServer(unpack(dataPacket))
        wait(0.01) 
    end 
end

